#------------------------------------------------------------------------------
# School Management System - environment configuration
#
# Copy to .env and adjust. Never commit a real .env file.
# Defaults below target the Docker Compose development stack (compose.yaml).
#------------------------------------------------------------------------------

APP_NAME="School Management System"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Host port Nginx is published on by Docker Compose
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

#------------------------------------------------------------------------------
# Logging
# LOG_CHANNEL=stack with LOG_STACK=json writes structured JSON lines to
# storage/logs/laravel.json.log; use "stderr_json" in containers/production.
#------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

#------------------------------------------------------------------------------
# Database (PostgreSQL recommended). Inside Docker the host is "db".
#------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=school_management
DB_USERNAME=school
DB_PASSWORD=change-me-locally
# Host port PostgreSQL is published on by Docker Compose (for GUI clients)
FORWARD_DB_PORT=5433

#------------------------------------------------------------------------------
# Sessions, cache and queues (Redis in Docker; "database" also works)
#------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when serving over HTTPS (always in production)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=sms_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

#------------------------------------------------------------------------------
# Mail (Mailpit in Docker: UI at http://localhost:8025)
#------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@school.test"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_UI_PORT=8025

#------------------------------------------------------------------------------
# API
#------------------------------------------------------------------------------
# Personal access token lifetime in minutes (default 7 days)
API_TOKEN_EXPIRATION=10080
# Requests per minute per authenticated user (or IP when anonymous)
API_RATE_LIMIT=60
# Comma separated SPA/stateful domains for Sanctum (not needed for token auth)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1

#------------------------------------------------------------------------------
# School domain settings (see config/school.php)
#------------------------------------------------------------------------------
STUDENT_NUMBER_PREFIX=S
GRADING_PASSING_SCORE=60
ATTENDANCE_WARNING_THRESHOLD=80
STUDENT_PHOTO_DISK=local
STUDENT_PHOTO_MAX_KB=2048
# Days before soft-deleted student records are permanently purged
STUDENT_RETENTION_DAYS=365

#------------------------------------------------------------------------------
# Optional S3-compatible storage (for photos/backups in production)
#------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
