#------------------------------------------------------------------------------
# Production environment template for compose.prod.yaml.
# Copy to .env.production, fill in real values and keep it out of version
# control (it is git-ignored). Prefer your platform's secret manager when
# deploying outside Docker Compose.
#------------------------------------------------------------------------------

APP_NAME="School Management System"
APP_ENV=production
# Generate once with: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://school.example.org
APP_TIMEZONE=UTC

# Comma separated proxy IPs/CIDRs allowed to set X-Forwarded-* headers
# (your load balancer or reverse proxy), or * when the app is only reachable
# through the proxy network.
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr_json
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=school_management
DB_USERNAME=school
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=sms_
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@school.example.org"
MAIL_FROM_NAME="${APP_NAME}"

API_TOKEN_EXPIRATION=10080
API_RATE_LIMIT=60

STUDENT_PHOTO_DISK=local
STUDENT_RETENTION_DAYS=365
