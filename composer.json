{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "school/school-management-system",
    "type": "project",
    "description": "School management system: students, courses, enrollment, grading, attendance and a versioned REST API.",
    "keywords": [
        "laravel",
        "livewire",
        "school",
        "education",
        "api"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "dedoc/scramble": "^0.13.45",
        "fakerphp/faker": "^1.23",
        "laravel/fortify": "^1.40",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^7.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --seed --force",
            "npm ci",
            "npm run build"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "format": [
            "vendor/bin/pint"
        ],
        "analyse": [
            "@php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --coverage --min=80"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "docs:api": [
            "@php artisan scramble:export"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "lint": "Check code style with Pint",
        "format": "Fix code style with Pint",
        "analyse": "Static analysis with Larastan",
        "test": "Run the test suite",
        "test:coverage": "Run the test suite with coverage (requires PCOV or Xdebug)",
        "check": "Run lint, static analysis and tests",
        "docs:api": "Export the OpenAPI document to docs/openapi.json"
    }
}
